# Sopho2SIP-Daemon als Systemdienst auf dem Pi (Nutzer pi, Repo unter /home/pi/Sopho2SIP).
# Installation:  sudo cp gateway/systemd/sopho2sipd.service /etc/systemd/system/
#                sudo systemctl daemon-reload && sudo systemctl enable --now sopho2sipd
# Ereignisse:    journalctl -u sopho2sipd -f
# Rohprotokoll:  ~/Sopho2SIP/logs/ergo_*.log (eine Datei pro Verbindungsaufbau)
# Anrufe:        ~/.local/share/sopho2sip/anrufe.jsonl
# Webhook:       ExecStart um --webhook URL ergänzen (systemctl edit sopho2sipd)

[Unit]
Description=Sopho2SIP-Gateway (ErgoLine D340 an der PC-Schnittstelle)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=dialout
WorkingDirectory=/home/pi/Sopho2SIP
ExecStart=/usr/bin/python3 -u gateway/sopho2sipd.py
# Der Daemon baut die Verbindung bei Fehlern selbst neu auf; Restart fängt Abstürze ab.
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
