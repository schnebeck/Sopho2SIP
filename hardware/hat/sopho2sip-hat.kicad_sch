	(text "Sopho2SIP-HAT: Raspberry Pi ⇄ ErgoLine D340 (PC-Schnittstelle RS-232, Audio-Buchse X_OUT/X_IN)" (exclude_from_sim no) (at 30.48 30.48 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "dc7f2dbb-00f0-43e7-a648-97c090b1f79b"))
	(text "Netze per Label; erzeugt von hardware/hat/erzeuge_schaltplan.py (nicht von Hand umverdrahten)" (exclude_from_sim no) (at 30.48 35.56 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "8b32e2c4-cae1-4248-bbbc-4319d90a2ac1"))
	(text "HAT-ID-EEPROM (Raspberry-Pi-HAT-Spezifikation): WP offen = schreibgeschützt, JP1 schließen zum Schreiben" (exclude_from_sim no) (at 30.48 204.47 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "f4384bd9-b4a1-4f75-b1f7-403ce39c662d"))
	(text "Codec WM8731: I²C 0x1A (CSB=0, MODE=0), Quarz 12,288 MHz," (exclude_from_sim no) (at 139.7 49.53 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "34748246-499f-4432-8bb4-bdc6e2b9245e"))
	(text "dtoverlay=rpi-proto; LHPOUT treibt den 600-Ω-Übertrager" (exclude_from_sim no) (at 139.7 54.61 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "a6200bb8-12ff-4657-8d56-c7ec774053c4"))
	(text "Sprechweg: zwei 600:600-Übertrager trennen Telefon (TEL_GNDA) und Pi (GND) galvanisch" (exclude_from_sim no) (at 279.4 54.61 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "131c07b4-cbba-497e-8ff8-f906fd36da0d"))
	(text "R4/R5: Teiler-Option für X_IN (Standard R4 = 0R, R5 unbestückt); Pegel per Codec einstellbar" (exclude_from_sim no) (at 279.4 60.96 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "fd2bceda-8f9a-48b7-b91b-cbcd83d1a5a0"))
	(text "RS-232 isoliert: ADuM5211 (Digitaltrenner + isolierte 3,3 V, VSEL=GND) + MAX3232; dtoverlay=uart3 (GPIO4/5)" (exclude_from_sim no) (at 240.03 209.55 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "44a90031-dfac-44ad-ab99-ff00e98c15b6"))
	(text "J3 = DE9-Stecker wie am PC: Pin 2 RxD, Pin 3 TxD, Pin 5 GND; 1:1-Kabel zur DE9-Buchse der D340 (1200 Bd 8O1)" (exclude_from_sim no) (at 240.03 215.9 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "d6284980-f61c-46d8-90a5-c66de645166a"))
